# Keep the image small and free of secrets/local artifacts.
.venv/
**/__pycache__/
*.pyc
*.pyo

# Secrets & generated Agent 365 state (never bake into the image)
.env
a365.config.json
a365.generated.config.json
a365.*.config.json
manifest/

# Repo/tooling noise not needed at runtime
scripts/
*.md
.git/
.gitignore
Dockerfile
.dockerignore
